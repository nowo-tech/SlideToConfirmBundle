{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN). The Vite entry only carries the bundle's own slide-to-confirm controller/CSS. -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}{{ 'demo.title'|trans }}{% endblock %}{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {{ vite_entry_link_tags('app') }}
    {% block styles %}{% endblock %}
{% endblock %}

{% block nowo_ui_navigation %}
    {% set locale_labels = {
        en: 'English',
        es: 'Español',
        it: 'Italiano',
        fr: 'Français',
        pt: 'Português',
        de: 'Deutsch',
        nl: 'Nederlands',
    } %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('demo_index', { _locale: app.request.locale }) }}">{{ 'demo.brand'|trans }}</a>
        <nav class="nowo-ui-menu" aria-label="{{ 'demo.language'|trans }}">
            {% for loc in locales|default(['en', 'es']) %}
                <a class="nowo-ui-link" href="{{ path('demo_index', { _locale: loc, case: current|default('payment') }) }}" title="{{ locale_labels[loc] }}"{% if app.request.locale == loc %} aria-current="page"{% endif %}>{{ loc|upper }}</a>
            {% endfor %}
        </nav>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('app') }}
    {% block scripts %}{% endblock %}
{% endblock %}
