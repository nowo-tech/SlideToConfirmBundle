{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.page_title'|trans }} – {{ ('demo.case.' ~ current ~ '.title')|trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.heading'|trans,
        intro: 'demo.description'|trans,
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: ('demo.case.' ~ current ~ '.title')|trans, intro: ('demo.case.' ~ current ~ '.body')|trans, kind: 'form', testid: 'demo-case'} %}
        {% block section_body %}
            {{ form_start(form, { attr: { id: 'demo-form', class: 'nowo-ui-form', novalidate: 'novalidate' } }) }}
                {% for child in form %}
                    {% if not child.rendered and child.vars.name != 'save' %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(form) }}
        {% endblock %}
        {% block section_footer %}
            {% if form.save is defined %}
                {% do form.save.setRendered %}
                <button type="submit" form="demo-form" class="nowo-ui-btn nowo-ui-btn--primary" disabled data-demo-gated-submit="1">{{ form.save.vars.label|trans }}</button>
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endblock %}
