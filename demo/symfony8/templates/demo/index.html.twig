{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.page_title'|trans }} – {{ ('demo.case.' ~ current ~ '.title')|trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.heading'|trans,
        intro: 'demo.description'|trans,
    }) }}
{% endblock %}

{% block body %}
    {% set _items = [] %}
    {% for case in use_cases %}
        {% set _items = _items|merge([{
            label: ('demo.case.' ~ case ~ '.nav')|trans,
            href: path('demo_index', { _locale: app.request.locale, case: case }),
            current: current == case,
        }]) %}
    {% endfor %}
    {{ include(nowo_ui_partial('tabs'), { items: _items, aria_label: 'demo.heading'|trans }) }}

    <section class="nowo-ui-card" data-testid="demo-case">
        <div class="nowo-ui-card__body">
            <h2 class="nowo-ui-card__title">{{ ('demo.case.' ~ current ~ '.title')|trans }}</h2>
            <p class="nowo-ui-muted">{{ ('demo.case.' ~ current ~ '.body')|trans }}</p>
            {{ form_start(form) }}
                {% for child in form %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(form) }}
        </div>
    </section>
{% endblock %}
