{
    "name": "nowo-tech/slide-to-confirm-demo-symfony8",
    "description": "Demo for SlideToConfirmBundle - Symfony 8.1",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "nowo-tech/slide-to-confirm-bundle": "@dev",
        "pentatrion/vite-bundle": "^8.2",
        "php": ">=8.4.1,<8.6",
        "symfony/asset": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/flex": "^2.0",
        "symfony/form": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/stimulus-bundle": "^3.0",
        "symfony/twig-bundle": "^8.1",
        "symfony/validator": "^8.1",
        "symfony/yaml": "^8.1",
        "twig/extra-bundle": "^3.12",
        "twig/string-extra": "^3.12"
    },
    "require-dev": {
        "nowo-tech/hot-reload-bundle": "^1.4",
        "nowo-tech/twig-inspector-bundle": "*",
        "symfony/debug-bundle": "^8.1",
        "symfony/web-profiler-bundle": "^8.1"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "8.1.*"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "/var/slide-to-confirm-bundle",
            "options": {
                "symlink": true
            }
        }
    ]
}
