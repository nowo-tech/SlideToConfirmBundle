{
  "name": "nowo-tech/slide-to-confirm-bundle",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "vite build && cp src/Resources/assets/css/slide-to-confirm.css src/Resources/public/slide-to-confirm.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "testTests": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@vitest/coverage-v8": "^3.2.6",
    "jsdom": "^30.0.1",
    "typescript": "~5.7.3",
    "vite": "^8.2.2",
    "vitest": "^3.2.6"
  }
}
